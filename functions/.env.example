# ============================================================================
# MAJANYA JI ETHNIC WEAR - FIREBASE FUNCTIONS SMTP CONFIGURATION
# ============================================================================
# Configure your SMTP credentials below to enable live transactional email
# notifications for Order Confirmations and Shipping Updates.
# 
# Supported providers: Gmail, SendGrid, Amazon SES, Brevo, Mailgun, Postmark, custom SMTP.

# SMTP Server hostname (e.g., smtp.gmail.com, smtp.sendgrid.net, email-smtp.us-east-1.amazonaws.com)
SMTP_HOST=smtp.gmail.com

# SMTP Server port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP Username / Login (e.g., your email or SendGrid apikey)
SMTP_USER=orders@majanyaji.com

# SMTP Password / App Password
SMTP_PASS=your-secure-app-password

# Sender Display Name and Address
SMTP_FROM="Majanya Ji Ethnic Wear" <orders@majanyaji.com>

# Secure connection (true for port 465, false for port 587/STARTTLS)
SMTP_SECURE=false
