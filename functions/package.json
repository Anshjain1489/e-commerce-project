{
  "name": "majanya-ji-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Majanya Ji Ethnic Wear automated transactional emails",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "nodemailer": "^6.9.10"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.14",
    "typescript": "^5.0.0"
  },
  "private": true
}
